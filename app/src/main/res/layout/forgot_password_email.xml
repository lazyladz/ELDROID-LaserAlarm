<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0B0B"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo (centered) -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo1"
            android:contentDescription="Laser Alarm Logo"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="18dp" />

        <!-- Title Block -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp">

            <!-- "Reset Password" aligned LEFT within centered block -->
            <TextView
                android:id="@+id/forgotPasswordTitle"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:textColor="#FF7F50"
                android:gravity="start"
                android:includeFontPadding="false"
                android:layout_marginBottom="2dp" />

            <!-- "LaserAlarm" aligned RIGHT within same block -->
            <TextView
                android:id="@+id/forgotPasswordAppName"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="LaserAlarm"
                android:textSize="28sp"
                android:textStyle="italic"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FF4500"
                android:gravity="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your email to receive a password reset link from Firebase"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSendCode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Send Reset Link"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_bg"
            android:layout_marginTop="18dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            style="?android:attr/progressBarStyleLarge"
            android:layout_marginTop="16dp"/>

        <!-- Back to Login -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Login"
            android:textColor="#FF7F50"
            android:textSize="14sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>